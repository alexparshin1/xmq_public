{
  "version": 1,
  "sections": [
    {
      "title": "MQTT messages",
      "fields": [
        {
          "name": "mqtt_filter"
        },
        {
          "name": "max_payload"
        },
        {
          "name": "topic_filter",
          "visible_when": {
            "setting": "mqtt_filter",
            "values": [
              "Topics"
            ]
          }
        },
        {
          "name": "mqtt_template",
          "widget": "multiline",
          "visible_when": {
            "setting": "mqtt_filter",
            "values": [
              "Topics"
            ]
          }
        },
        {
          "name": "sql_rule",
          "widget": "multiline",
          "visible_when": {
            "setting": "mqtt_filter",
            "values": [
              "SQL rules"
            ]
          }
        }
      ]
    },
    {
      "title": "Delivery",
      "fields": [
        {
          "name": "sink"
        }
      ]
    },
    {
      "title": "Persistent delivery",
      "fields": [
        {
          "name": "persistent_delivery"
        },
        {
          "name": "delivery_queue_path"
        },
        {
          "name": "delivery_queue_mib",
          "visible_when": {
            "setting": "persistent_delivery",
            "values": [
              "true"
            ]
          }
        }
      ]
    },
    {
      "title": "HTTP/HTTPS request",
      "fields": [
        {
          "name": "url"
        },
        {
          "name": "secret"
        },
        {
          "name": "headers"
        },
        {
          "name": "timeout_ms"
        },
        {
          "name": "retries"
        },
        {
          "name": "concurrency"
        }
      ],
      "visible_when": {
        "setting": "sink",
        "values": [
          "http_sink"
        ]
      }
    },
    {
      "title": "Database",
      "fields": [
        {
          "name": "db_type"
        },
        {
          "name": "database_uri",
          "visible_when": {
            "setting": "db_type",
            "values": [
              "Use saved URI"
            ]
          }
        },
        {
          "name": "db_host",
          "visible_when": {
            "setting": "db_type",
            "values": [
              "postgresql",
              "mysql",
              "oracle",
              "mssql"
            ]
          }
        },
        {
          "name": "db_port",
          "visible_when": {
            "setting": "db_type",
            "values": [
              "postgresql",
              "mysql",
              "oracle",
              "mssql"
            ]
          }
        },
        {
          "name": "db_name",
          "visible_when": {
            "setting": "db_type",
            "values": [
              "postgresql",
              "mysql",
              "oracle",
              "mssql"
            ]
          }
        },
        {
          "name": "db_user",
          "visible_when": {
            "setting": "db_type",
            "values": [
              "postgresql",
              "mysql",
              "oracle",
              "mssql"
            ]
          }
        },
        {
          "name": "db_password",
          "visible_when": {
            "setting": "db_type",
            "values": [
              "postgresql",
              "mysql",
              "oracle",
              "mssql"
            ]
          }
        },
        {
          "name": "db_path",
          "visible_when": {
            "setting": "db_type",
            "values": [
              "sqlite3"
            ]
          }
        },
        {
          "name": "insert_sql",
          "widget": "multiline"
        }
      ],
      "visible_when": {
        "setting": "sink",
        "values": [
          "db_sink"
        ]
      }
    },
    {
      "title": "Kafka",
      "fields": [
        {
          "name": "bootstrap_servers"
        },
        {
          "name": "kafka_topic"
        },
        {
          "name": "kafka_timeout_ms"
        }
      ],
      "visible_when": {
        "setting": "sink",
        "values": [
          "kafka_sink"
        ]
      }
    }
  ]
}
