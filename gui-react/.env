# Read by react-scripts from the directory the build runs in. Kept as a file rather than set in
# the environment because the interface is built on Linux, Windows, and FreeBSD, and a variable
# prefixed onto the npm command in package.json works on none of them but the first.

# No source maps in a production build. They were 4.75 MB of every package - a third of the
# Windows installer - and they carry the unminified sources of the interface, which nothing that
# installs a broker has any use for. Deleting them by hand does not hold: the next React build
# writes them again, and the packagers pick up whatever is in the build directory.
GENERATE_SOURCEMAP=false
