{
  "name": "the second node is taken away and brought back under load",
  "comments": [
    "A node is taken away under load and brought back: the load's subscribers are on it, so the",
    "cluster has to take their sessions back when it returns. On the default stand of stand.sh -",
    "six nodes, two on each of thinker10, thinker11 and theater - run from thinker10, where",
    "~/cluster/stand.sh reaches every node by itself."
  ],
  "server": {
    "username": "user",
    "password": "User-Secret1"
  },
  "load": {
    "scenario": "cluster-p2p-small.json",
    "groups": [
      {
        "name": "publishers",
        "node": "node1"
      },
      {
        "name": "subscribers",
        "node": "node4"
      }
    ]
  },
  "nodes": [
    {
      "name": "node1",
      "host": "thinker10",
      "port": 2884,
      "stop": "~/cluster/stand.sh stop {node}",
      "start": "~/cluster/stand.sh start {node}"
    },
    {
      "name": "node4",
      "host": "thinker11",
      "port": 2887,
      "stop": "~/cluster/stand.sh stop {node}",
      "start": "~/cluster/stand.sh start {node}"
    }
  ],
  "timeline": [
    {
      "at": 30,
      "action": "stop",
      "node": "node4"
    },
    {
      "at": 60,
      "action": "start",
      "node": "node4"
    },
    {
      "at": 100,
      "action": "check"
    }
  ],
  "checks": [
    {
      "name": "all six nodes are members",
      "kind": "redis",
      "uri": "redis://theater:6379/4",
      "command": "ZCARD cluster:members",
      "expect": "6"
    },
    {
      "name": "a coordinator is leading",
      "kind": "redis",
      "uri": "redis://theater:6379/4",
      "command": "GET cluster:coordinator",
      "nonempty": true
    },
    {
      "name": "the node that was away serves clients again",
      "kind": "mqtt",
      "action": "connect",
      "node": "node4",
      "expect": true
    },
    {
      "name": "a message crosses the cluster",
      "kind": "mqtt",
      "action": "deliver",
      "publish-node": "node1",
      "subscribe-node": "node4",
      "topic": "cluster/test/cross",
      "payload": "cross-node",
      "timeout": 15
    },
    {
      "name": "a retained message crosses the cluster",
      "kind": "mqtt",
      "action": "retained",
      "publish-node": "node4",
      "subscribe-node": "node1",
      "topic": "cluster/test/retained",
      "payload": "retained-across",
      "timeout": 15
    }
  ],
  "before": [
    "~/cluster/stand.sh mark"
  ],
  "after": [
    "~/cluster/stand.sh check-logs"
  ]
}
