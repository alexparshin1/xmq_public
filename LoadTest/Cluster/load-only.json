{
  "name": "the load alone, with nothing done to the cluster",
  "comments": [
    "The baseline for the tests that change the cluster under the load: the same scenario and the",
    "same checks with an empty timeline. What it measures is what the cluster does when it is left",
    "alone, which is what the other tests are read against."
  ],
  "cluster": "node1@client-host node2@client-host node3@server-host node4@server-host node5@farm-host node6@farm-host",
  "server": {
    "username": "user",
    "password": "User-Secret1"
  },
  "load": {
    "scenario": "cluster-p2p-small.json",
    "groups": [
      {
        "name": "publishers",
        "node": "node1"
      },
      {
        "name": "subscribers",
        "node": "node3"
      }
    ]
  },
  "nodes": [
    {
      "name": "node1",
      "host": "client-host",
      "stop": "~/cluster/test_cluster.sh stop {node}",
      "start": "~/cluster/test_cluster.sh start {node}"
    },
    {
      "name": "node3",
      "host": "server-host",
      "stop": "~/cluster/test_cluster.sh stop {node}",
      "start": "~/cluster/test_cluster.sh start {node}"
    }
  ],
  "timeline": [],
  "checks": [
    {
      "name": "all six nodes are members",
      "kind": "redis",
      "uri": "redis://farm-host:6379/4",
      "command": "ZCARD cluster:members",
      "expect": "6"
    },
    {
      "name": "a message crosses the cluster",
      "kind": "mqtt",
      "action": "deliver",
      "publish-node": "node1",
      "subscribe-node": "node3",
      "topic": "cluster/test/baseline",
      "payload": "cross-node",
      "timeout": 15
    }
  ],
  "before": [
    "~/cluster/test_cluster.sh mark"
  ],
  "after": [
    "~/cluster/test_cluster.sh check-logs"
  ]
}
