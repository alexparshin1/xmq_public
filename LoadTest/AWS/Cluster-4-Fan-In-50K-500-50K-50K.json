{
  "name": "Cluster-4-Fan-In-50K-500-50K-50K",
  "type": "Fan-In",
  "comments": [
    "Four-node AWS cluster: node-a 172.31.13.230 (A), node-b 172.31.13.222 (B),",
    "node-c 172.31.8.125 (C), node-d 172.31.11.169 (D); MQTT 1884 on each.",
    "The same file is used for XMQ and EMQX: the four nodes are rebuilt with one broker",
    "at a time and keep their addresses, so only the broker changes. The account",
    "user/User-Secret1 exists in the shared accounts database of whichever broker is",
    "installed; authentication is part of the test, not a setup detail.",
    "3 publisher nodes (A, B, C) and 1 subscriber node (D): 50k publishers spread over",
    "A, B and C, 500 shared subscribers on D. The shared subscription is cluster-wide."
  ],
  "publishers": {
    "id_prefix": "test-publisher-",
    "protocol_version": 5,
    "client_count": 50000,
    "qos": 1,
    "clean_session": true,
    "topics": "test/$clientindex",
    "servers": [
      {
        "hostname": "172.31.13.230",
        "port": 1884
      },
      {
        "hostname": "172.31.13.222",
        "port": 1884
      },
      {
        "hostname": "172.31.8.125",
        "port": 1884
      }
    ]
  },
  "subscribers": {
    "id_prefix": "test-subscriber-",
    "protocol_version": 5,
    "client_count": 500,
    "qos": 1,
    "clean_session": true,
    "topics": "$share/benchmark/test/#",
    "servers": [
      {
        "hostname": "172.31.11.169",
        "port": 1884
      }
    ]
  },
  "server": {
    "hostname": "172.31.13.230",
    "port": 1884,
    "username": "user",
    "password": "User-Secret1"
  },
  "parameters": {
    "connection_rate": 5000,
    "duration_sec": 600,
    "payload_size": 16,
    "publish_rate": 1,
    "keep_alive_sec": 300,
    "max_inflight_messages": 1024
  }
}
