{
  "name": "six nodes on three machines",
  "comments": [
    "Two nodes on each of thinker10, thinker11 and theater, so the cluster's links cross a real",
    "network instead of loopback - the cheaper and the less honest of the two arrangements.",
    "",
    "The load is the small point-to-point scenario: publishers on node3 (thinker11), subscribers on",
    "node6 (theater), so every message in it crosses a machine boundary. node6 is taken away at 40s",
    "and brought back at 70s; the checks then ask whether the cluster is whole again, whether every",
    "machine still serves clients, and whether traffic crosses the hosts."
  ],
  "server": {
    "username": "user",
    "password": "User-Secret1"
  },
  "load": {
    "scenario": "cluster-p2p-small.json",
    "groups": [
      { "name": "publishers", "node": "node3" },
      { "name": "subscribers", "node": "node6" }
    ]
  },
  "nodes": [
    {
      "name": "node1",
      "host": "thinker10",
      "port": 2884,
      "stop": "ssh thinker10 /home/alexeyp/cluster/stand.sh stop {node}",
      "start": "ssh thinker10 /home/alexeyp/cluster/stand.sh start {node}"
    },
    {
      "name": "node2",
      "host": "thinker10",
      "port": 2885,
      "stop": "ssh thinker10 /home/alexeyp/cluster/stand.sh stop {node}",
      "start": "ssh thinker10 /home/alexeyp/cluster/stand.sh start {node}"
    },
    {
      "name": "node3",
      "host": "thinker11",
      "port": 2886,
      "stop": "ssh thinker11 /home/alexeyp/cluster/stand.sh stop {node}",
      "start": "ssh thinker11 /home/alexeyp/cluster/stand.sh start {node}"
    },
    {
      "name": "node4",
      "host": "thinker11",
      "port": 2887,
      "stop": "ssh thinker11 /home/alexeyp/cluster/stand.sh stop {node}",
      "start": "ssh thinker11 /home/alexeyp/cluster/stand.sh start {node}"
    },
    {
      "name": "node5",
      "host": "theater",
      "port": 2888,
      "stop": "ssh theater /home/alexeyp/cluster/stand.sh stop {node}",
      "start": "ssh theater /home/alexeyp/cluster/stand.sh start {node}"
    },
    {
      "name": "node6",
      "host": "theater",
      "port": 2889,
      "stop": "ssh theater /home/alexeyp/cluster/stand.sh stop {node}",
      "start": "ssh theater /home/alexeyp/cluster/stand.sh start {node}"
    }
  ],
  "timeline": [
    { "at": 40, "action": "stop", "node": "node6" },
    { "at": 70, "action": "start", "node": "node6" },
    { "at": 100, "action": "check" }
  ],
  "checks": [
    {
      "name": "all six nodes are members",
      "kind": "redis",
      "uri": "redis://theater:6379/4",
      "command": "ZCARD cluster:members",
      "expect": "6"
    },
    {
      "name": "a coordinator is leading",
      "kind": "redis",
      "uri": "redis://theater:6379/4",
      "command": "GET cluster:coordinator",
      "nonempty": true
    },
    {
      "name": "thinker10 serves clients",
      "kind": "mqtt",
      "action": "connect",
      "node": "node1",
      "expect": true
    },
    {
      "name": "thinker11 serves clients",
      "kind": "mqtt",
      "action": "connect",
      "node": "node3",
      "expect": true
    },
    {
      "name": "theater serves clients",
      "kind": "mqtt",
      "action": "connect",
      "node": "node5",
      "expect": true
    },
    {
      "name": "the node that was away serves clients again",
      "kind": "mqtt",
      "action": "connect",
      "node": "node6",
      "expect": true
    },
    {
      "name": "a message crosses the machines",
      "kind": "mqtt",
      "action": "deliver",
      "publish-node": "node3",
      "subscribe-node": "node6",
      "topic": "cluster/test/across-machines",
      "payload": "across",
      "timeout": 15
    },
    {
      "name": "a retained message crosses the machines",
      "kind": "mqtt",
      "action": "retained",
      "publish-node": "node5",
      "subscribe-node": "node1",
      "topic": "cluster/test/retained-across-machines",
      "payload": "retained-across",
      "timeout": 15
    }
  ]
}
